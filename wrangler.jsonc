{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoru-foundry-site",
  "compatibility_date": "2026-09-10",
  "preview_urls": true,
  // Static files are served first; the Worker handles only the commission form (/api/commission).
  // It sends through Resend once the RESEND_API_KEY secret is set (README, "Commission form email").
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
