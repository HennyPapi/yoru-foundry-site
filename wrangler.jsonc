{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoru-foundry-site",
  "compatibility_date": "2026-09-10",
  "preview_urls": true,
  // Static files are served first; the Worker handles only the commission form (/api/commission).
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
  // Turn on after Email Routing is enabled for yorufoundry.com (see README, "Commission form email"):
  // ,"send_email": [{ "name": "COMMISSION_EMAIL" }]
}
